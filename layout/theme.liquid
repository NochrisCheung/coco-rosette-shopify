<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    {{ 'didot-lt-pro-roman.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {{ 'bickham-script-pro-regular.ttf' | asset_url | preload_tag: as: 'font', type: 'font/ttf' }}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

    {{ content_for_header }}
  </head>

  <body class="coco-rosette template-{{ request.page_type | handleize }}">
    <a class="coco-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}
    {% section 'cart-drawer' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    <div class="coco-live-region" aria-live="polite" data-live-region></div>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
