{% doc %}
  Renders Shopify form errors in an accessible, reusable format.

  @param {form} form - Shopify form object.
  @param {string} [id] - Optional stable DOM id for the error container.
{% enddoc %}

{% if form.errors %}
  <div{% if id != blank %} id="{{ id }}"{% endif %} class="coco-form-errors" role="alert" tabindex="-1">
    <p>{{ 'forms.error_heading' | t }}</p>
    <ul class="coco-error-list">
      {% for field in form.errors %}
        <li>{{ form.errors.messages[field] }}</li>
      {% endfor %}
    </ul>
  </div>
{% endif %}
