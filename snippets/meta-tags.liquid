<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description

  if request.page_type == 'collection' and collection.handle == 'all'
    assign seo_title = 'seo.all_dogwear_title' | t
    assign seo_description = 'seo.all_dogwear_description' | t
  endif

  assign og_title = seo_title
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: shop.name
  assign social_image = page_image | default: settings.social_share_image

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url | escape }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if social_image -%}
  <meta
    property="og:image"
    content="https:{{ social_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ social_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ social_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ social_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.selected_or_first_available_variant.price | default: product.price | divided_by: 100.0 }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- unless request.page_type == 'password' or request.page_type == '404' or request.page_type == 'search' -%}
  {%- liquid
    assign organisation_id = request.origin | append: '/#organization'
    assign website_id = request.origin | append: '/#website'
    assign organisation_logo_url = 'coco-rosette-wordmark.png' | asset_url | prepend: 'https:'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ organisation_id | json }},
          "name": {{ shop.name | json }},
          "url": {{ request.origin | json }},
          "logo": {{ organisation_logo_url | json }},
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "email": "contact@cocorosette.com",
            "availableLanguage": "en"
          }
        },
        {
          "@type": "WebSite",
          "@id": {{ website_id | json }},
          "name": {{ shop.name | json }},
          "url": {{ request.origin | json }},
          "publisher": {
            "@id": {{ organisation_id | json }}
          },
          "inLanguage": {{ request.locale.iso_code | json }}
        }
      ]
    }
  </script>
{%- endunless -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{% if social_image %}
  <meta name="twitter:image" content="https:{{ social_image | image_url: width: 1200 }}">
{% endif %}

<title>
  {{ seo_title | escape }}
  {%- if current_tags %}{% assign seo_tags = current_tags | join: ', ' %} &ndash; {{ 'seo.tagged' | t: tags: seo_tags | escape }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'collections.page_number' | t: number: current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url | escape }}"
>

{% if settings.favicon != blank %}
  <link
    rel="icon"
    type="image/png"
    sizes="192x192"
    href="{{ settings.favicon | image_url: width: 192 }}"
  >
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="{{ settings.favicon | image_url: width: 180 }}"
  >
{% else %}
  <link
    rel="icon"
    type="image/png"
    sizes="192x192"
    href="{{ 'coco-rosette-favicon.png' | asset_url }}"
  >
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="{{ 'coco-rosette-favicon.png' | asset_url }}"
  >
{% endif %}

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}

{% if request.page_type == 'password' or request.page_type == '404' or request.page_type == 'search' %}
  <meta name="robots" content="noindex,nofollow">
{% endif %}
