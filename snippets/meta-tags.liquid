<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description

  if request.page_type == 'collection' and collection.handle == 'all'
    assign seo_title = 'All Dogwear | Luxury Occasionwear for Dogs | Coco Rosette'
    assign seo_description = 'Explore Coco Rosette’s made-to-order dog wedding dresses, evening gowns and partywear for celebrations, photographs and special occasions.'
  endif

  assign og_title = seo_title
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: shop.name
  assign social_image = page_image | default: settings.social_share_image

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url | escape }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if social_image -%}
  <meta
    property="og:image"
    content="https:{{ social_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ social_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ social_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ social_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{% if social_image %}
  <meta name="twitter:image" content="https:{{ social_image | image_url: width: 1200 }}">
{% endif %}

<title>
  {{ seo_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' | escape }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url | escape }}"
>

{% if settings.favicon != blank %}
  <link rel="icon" href="{{ settings.favicon | image_url: width: 48 }}">
{% else %}
  <link rel="icon" href="{{ 'coco-rosette-rose-mark.png' | asset_url }}" type="image/png">
{% endif %}

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}

{% if request.page_type == 'password' or request.page_type == '404' or request.page_type == 'search' %}
  <meta name="robots" content="noindex,nofollow">
{% endif %}
