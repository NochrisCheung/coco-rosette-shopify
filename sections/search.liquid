{% liquid
  assign escaped_search_terms = search.terms | escape
  assign search_facets_form_id = 'SearchFacets-' | append: section.id
%}

<section class="coco-search-page coco-content">
  <header class="coco-search-page__header">
    <p class="coco-eyebrow">{{ 'search.eyebrow' | t }}</p>
    <h1 class="coco-display">{{ 'search.title' | t }}</h1>
    <form class="coco-search-page__form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <label class="coco-visually-hidden" for="SearchInput-{{ section.id }}">{{ 'search.placeholder' | t }}</label>
      <input id="SearchInput-{{ section.id }}" class="coco-field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocorrect="off" autocomplete="off" autocapitalize="off" spellcheck="false" required>
      <button class="coco-button" type="submit">{{ 'search.submit' | t }}</button>
    </form>
  </header>

  {% if search.performed %}
    <p class="coco-search-page__summary" role="status">
      {% if search.results_count == 0 %}
        {{ 'search.no_results' | t: terms: escaped_search_terms }}
      {% else %}
        {{ 'search.results_for' | t: terms: escaped_search_terms, count: search.results_count }}
      {% endif %}
    </p>

    {% if search.results_count > 0 %}
      {% paginate search.results by 16 %}
        <div class="coco-catalogue-layout">
          {% render 'product-facets',
            results: search,
            results_url: routes.search_url,
            form_id: search_facets_form_id,
            search_terms: search.terms
          %}

          <div class="coco-catalogue-results">
            <p class="coco-catalogue-results__count" role="status">{{ 'search.product_count' | t: count: search.results_count }}</p>
            <div class="coco-search-page__grid">
              {% for result in search.results %}
                {% if result.object_type == 'product' %}
                  {% render 'product-card', product: result %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        {{ paginate | default_pagination }}
      {% endpaginate %}
    {% endif %}
  {% else %}
    <p class="coco-search-page__summary">{{ 'search.empty_query' | t }}</p>
  {% endif %}
</section>

{% stylesheet %}
  .coco-search-page { padding-block: var(--cr-section-space); }
  .coco-search-page__header { max-width: 44rem; margin-inline: auto; text-align: center; }
  .coco-search-page__header .coco-eyebrow { margin-bottom: 0.75rem; }
  .coco-search-page__form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.75rem; margin-top: 2rem; }
  .coco-search-page__summary { margin: 3rem 0 1.5rem; color: var(--cr-gray); text-align: center; }
  .coco-search-page__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.25rem; }
  .coco-search-page .pagination { display: flex; justify-content: center; gap: 0.75rem; margin-top: 3rem; }
  .coco-search-page .pagination a, .coco-search-page .pagination .current { min-width: 2.5rem; padding: 0.5rem; color: var(--cr-gray); text-align: center; text-decoration: none; }
  .coco-search-page .pagination .current { border-bottom: 1px solid var(--cr-rose); color: var(--cr-ink); }
  @media (max-width: 900px) { .coco-search-page__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1.25rem; } }
  @media (max-width: 500px) { .coco-search-page__form { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Search",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
