{% liquid
  assign collection_eyebrow = 'collections.eyebrow' | t
  assign collection_handles = 'wedding-dresses,evening-gowns,casual' | split: ','
%}

<section class="coco-collections-page coco-content">
  <header class="coco-collections-page__header">
    <p class="coco-eyebrow">{{ collection_eyebrow | escape }}</p>
    <h1 class="coco-display">{{ 'collections.title' | t }}</h1>
    {% render 'rose-heading-ornament' %}
  </header>

  <div class="coco-collections-page__grid">
    {% for handle in collection_handles %}
      {% assign collection_item = collections[handle] %}
      {% if collection_item != blank and collection_item.products_count > 0 %}
        {% assign collection_item_image_alt = 'collections.image_alt' | t: title: collection_item.title %}
        <article class="coco-collection-directory-card">
          <a class="coco-collection-directory-card__link" href="{{ collection_item.url }}">
            <div class="coco-collection-directory-card__media">
              {% if collection_item.featured_image != blank %}
                {% render 'responsive-image',
                  image: collection_item.featured_image,
                  alt: collection_item_image_alt,
                  class: 'coco-collection-directory-card__image',
                  width: 1200,
                  widths: '400, 560, 720, 960, 1200',
                  sizes: '(min-width: 901px) 30vw, (min-width: 601px) 45vw, 100vw'
                %}
              {% else %}
                <div class="coco-collection-directory-card__media-placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>
            <div class="coco-collection-directory-card__details">
              <h2 class="coco-collection-directory-card__title">{{ collection_item.title | escape }}</h2>
              {% if collection_item.description != blank %}
                <div class="coco-collection-directory-card__description rte">{{ collection_item.description | strip_html | truncatewords: 18 | escape }}</div>
              {% endif %}
              <span class="coco-text-link coco-collection-directory-card__action">{{ 'collections.view_all' | t: title: collection_item.title }}</span>
            </div>
          </a>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .coco-collections-page { padding-block: var(--cr-section-space); }
  .coco-collections-page__header { margin-bottom: clamp(3.5rem, 8vw, 6rem); text-align: center; }
  .coco-collections-page__header .coco-eyebrow { margin: 0 0 0.75rem; }
  .coco-collections-page__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); }
  .coco-collection-directory-card { min-width: 0; }
  .coco-collection-directory-card__link { display: block; color: var(--cr-ink); text-decoration: none; }
  .coco-collection-directory-card__media { aspect-ratio: 4 / 5; overflow: hidden; background: var(--cr-white); }
  .coco-collection-directory-card__image, .coco-collection-directory-card__media-placeholder { width: 100%; height: 100%; }
  .coco-collection-directory-card__image { object-fit: cover; transition: transform 700ms ease; }
  .coco-collection-directory-card__media-placeholder { background: linear-gradient(180deg, var(--cr-placeholder-wash), transparent); }
  .coco-collection-directory-card__link:hover .coco-collection-directory-card__image { transform: scale(1.04); }
  .coco-collection-directory-card__details { padding-top: 1.25rem; text-align: center; }
  .coco-collection-directory-card__title { font-family: var(--cr-serif); font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 500; line-height: 1.15; }
  .coco-collection-directory-card__description { margin-top: 0.75rem; color: var(--cr-gray); font-size: 0.8125rem; line-height: 1.6; }
  .coco-collection-directory-card__action { display: inline-block; margin-top: 1rem; }
  @media (max-width: 900px) { .coco-collections-page__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .coco-collections-page__grid { grid-template-columns: 1fr; gap: 2.5rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
