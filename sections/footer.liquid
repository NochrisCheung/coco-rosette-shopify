{% liquid
  assign has_brand_links = false
  assign has_customer_care_links = false
  assign has_social_links = false
  assign has_legal_links = false

  if section.settings.instagram_url != blank
    assign has_social_links = true
  endif

  if section.settings.brand_menu != blank and section.settings.brand_menu.links.size > 0
    for link in section.settings.brand_menu.links
      assign is_legal_link = false

      if link.url == routes.search_url
        assign is_legal_link = true
      elsif shop.shipping_policy != blank and link.url == shop.shipping_policy.url
        assign is_legal_link = true
      elsif shop.refund_policy != blank and link.url == shop.refund_policy.url
        assign is_legal_link = true
      elsif shop.privacy_policy != blank and link.url == shop.privacy_policy.url
        assign is_legal_link = true
      elsif shop.terms_of_service != blank and link.url == shop.terms_of_service.url
        assign is_legal_link = true
      endif

      unless is_legal_link
        assign has_brand_links = true
        break
      endunless
    endfor
  endif

  if section.settings.menu != blank and section.settings.menu.links.size > 0
    for link in section.settings.menu.links
      assign is_legal_link = false

      if link.url == routes.search_url
        assign is_legal_link = true
      elsif shop.shipping_policy != blank and link.url == shop.shipping_policy.url
        assign is_legal_link = true
      elsif shop.refund_policy != blank and link.url == shop.refund_policy.url
        assign is_legal_link = true
      elsif shop.privacy_policy != blank and link.url == shop.privacy_policy.url
        assign is_legal_link = true
      elsif shop.terms_of_service != blank and link.url == shop.terms_of_service.url
        assign is_legal_link = true
      endif

      unless is_legal_link
        assign has_customer_care_links = true
        break
      endunless
    endfor
  endif

  if section.blocks.size > 0
    for block in section.blocks
      if block.settings.url != blank and block.settings.label != blank
        assign has_social_links = true
        break
      endif
    endfor
  endif

  if shop.shipping_policy != blank or shop.refund_policy != blank or shop.privacy_policy != blank or shop.terms_of_service != blank
    assign has_legal_links = true
  endif

  if section.settings.privacy_menu != blank and section.settings.privacy_menu.links.size > 0
    assign has_legal_links = true
  endif

%}

<footer class="coco-footer">
  <div class="coco-footer__main">
    <div class="coco-footer__identity">
      <a class="coco-footer__logo" href="{{ routes.root_url }}" aria-label="{{ 'accessibility.home' | t: shop_name: shop.name | escape }}">
        {% render 'logo', class: 'coco-footer__logo-image', width: 230 %}
      </a>
      <p class="coco-footer__signature">© {{ 'now' | date: '%Y' }} Coco Rosette — {{ 'brand.tagline' | t }}</p>

      {% if has_social_links %}
        <nav class="coco-footer__social" aria-label="{{ 'accessibility.footer_social_navigation' | t }}">
          <ul class="coco-footer__social-list" role="list">
            {% if section.settings.instagram_url != blank %}
              <li>
                <a class="coco-footer__instagram" href="{{ section.settings.instagram_url | escape }}" aria-label="Instagram — Coco Rosette">
                  {% render 'icon', name: 'instagram', class: 'coco-icon' %}
                </a>
              </li>
            {% endif %}
            {% for block in section.blocks %}
              {% if block.settings.url != blank and block.settings.label != blank %}
                <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | escape }}">{{ block.settings.label | escape }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
      <div class="coco-footer__localisation">
        {% assign footer_localisation_id = 'FooterLocalisation-' | append: section.id %}
        {% render 'localisation-controls', id_prefix: footer_localisation_id %}
      </div>
    </div>

    {% if has_brand_links or has_customer_care_links or has_legal_links %}
      <div class="coco-footer__navigation-groups">
        {% if has_brand_links or has_customer_care_links %}
          <nav class="coco-footer__navigation" aria-label="{{ 'accessibility.footer_navigation' | t }}">
            <ul class="coco-footer__navigation-list" role="list">
              {% if has_brand_links %}
                {% for link in section.settings.brand_menu.links %}
                  {% liquid
                    assign is_legal_link = false

                    if link.url == routes.search_url
                      assign is_legal_link = true
                    elsif shop.shipping_policy != blank and link.url == shop.shipping_policy.url
                      assign is_legal_link = true
                    elsif shop.refund_policy != blank and link.url == shop.refund_policy.url
                      assign is_legal_link = true
                    elsif shop.privacy_policy != blank and link.url == shop.privacy_policy.url
                      assign is_legal_link = true
                    elsif shop.terms_of_service != blank and link.url == shop.terms_of_service.url
                      assign is_legal_link = true
                    endif
                  %}
                  {% unless is_legal_link %}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {% endunless %}
                {% endfor %}
              {% endif %}

              {% if has_customer_care_links %}
                {% for link in section.settings.menu.links %}
                  {% liquid
                    assign is_legal_link = false

                    if link.url == routes.search_url
                      assign is_legal_link = true
                    elsif shop.shipping_policy != blank and link.url == shop.shipping_policy.url
                      assign is_legal_link = true
                    elsif shop.refund_policy != blank and link.url == shop.refund_policy.url
                      assign is_legal_link = true
                    elsif shop.privacy_policy != blank and link.url == shop.privacy_policy.url
                      assign is_legal_link = true
                    elsif shop.terms_of_service != blank and link.url == shop.terms_of_service.url
                      assign is_legal_link = true
                    endif
                  %}
                  {% unless is_legal_link %}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {% endunless %}
                {% endfor %}
              {% endif %}
            </ul>
          </nav>
        {% endif %}

        {% if has_legal_links %}
          <nav class="coco-footer__navigation coco-footer__legal" aria-label="{{ 'accessibility.legal_navigation' | t }}">
            <ul class="coco-footer__navigation-list" role="list">
              {% if shop.shipping_policy != blank %}<li><a href="{{ shop.shipping_policy.url }}">{{ 'footer.delivery_policy' | t }}</a></li>{% endif %}
              {% if shop.refund_policy != blank %}<li><a href="{{ shop.refund_policy.url }}">{{ 'footer.returns_and_refunds' | t }}</a></li>{% endif %}
              {% if shop.privacy_policy != blank %}<li><a href="{{ shop.privacy_policy.url }}">{{ 'footer.privacy_policy' | t }}</a></li>{% endif %}
              {% if shop.privacy_policy != blank %}<li><button class="coco-footer__privacy-button" type="button" data-cookie-preferences>{{ 'footer.cookie_preferences' | t }}</button></li>{% endif %}
              {% if shop.terms_of_service != blank %}<li><a href="{{ shop.terms_of_service.url }}">{{ 'footer.terms_of_service' | t }}</a></li>{% endif %}
              {% if section.settings.privacy_menu != blank %}
                {% for link in section.settings.privacy_menu.links %}
                  {% liquid
                    assign privacy_link_url = link.url
                    assign opt_out_path = '/pages/data-sharing-opt-out'
                    assign shop_opt_out_url = shop.url | append: opt_out_path
                    assign current_opt_out_url = request.origin | append: opt_out_path
                    if link.url == opt_out_path or link.url == shop_opt_out_url or link.url == current_opt_out_url
                      if pages['data-sharing-opt-out'] != blank
                        assign privacy_link_url = pages['data-sharing-opt-out'].url
                      endif
                    endif
                  %}
                  <li><a href="{{ privacy_link_url | escape }}">{{ link.title | escape }}</a></li>
                {% endfor %}
              {% endif %}
            </ul>
          </nav>
        {% endif %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .coco-footer { margin-inline: var(--cr-gutter); padding: 4rem 0 2.25rem; border-top: 1px solid var(--cr-divider); }
  .coco-footer__main { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem 4rem; }
  .coco-footer__identity { display: grid; flex: 0 0 auto; justify-items: start; gap: 0.875rem; }
  .coco-footer__logo { display: block; }
  .coco-footer__logo-image { width: 11.25rem; height: auto; }
  .coco-footer__social-list, .coco-footer__navigation-list { display: flex; flex-wrap: wrap; margin: 0; padding: 0; list-style: none; }
  .coco-footer__social-list { gap: 0.5rem 1.25rem; }
  .coco-footer__instagram { display: inline-grid; width: 3rem; height: 3rem; place-items: center; }
  .coco-footer__instagram .coco-icon { width: 1.375rem; height: 1.375rem; }
  .coco-footer__localisation { max-width: 100%; }
  .coco-footer__navigation-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); flex: 1 1 26rem; gap: 1rem clamp(1.5rem, 4vw, 3.5rem); max-width: 34rem; }
  .coco-footer__navigation-list { flex-direction: column; flex-wrap: nowrap; align-items: flex-start; gap: 0.625rem; }
  .coco-footer__navigation-list > li { max-width: 100%; }
  .coco-footer a, .coco-footer__privacy-button, .coco-footer__signature { color: var(--cr-gray); font-size: 0.625rem; font-weight: 400; letter-spacing: 0.18em; line-height: 1.6; text-decoration: none; text-transform: uppercase; }
  .coco-footer__privacy-button { border: 0; padding: 0; background: transparent; }
  .coco-footer a:hover, .coco-footer__privacy-button:hover { color: var(--cr-ink); }
  .coco-footer__signature { margin: 0; white-space: nowrap; }
  .coco-footer a.coco-footer__instagram { color: var(--cr-ink); }
  @media (max-width: 850px) {
    .coco-footer__localisation { display: none; }
  }
  @media (max-width: 700px) {
    .coco-footer { padding-top: 3rem; }
    .coco-footer__main { flex-direction: column; align-items: center; text-align: center; }
    .coco-footer__identity { justify-items: center; }
    .coco-footer__navigation-groups { width: 100%; flex: none; }
    .coco-footer__navigation-list { align-items: center; gap: 0.75rem; }
    .coco-footer__signature { white-space: normal; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coco Rosette footer",
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "link_list",
      "id": "brand_menu",
      "label": "Website pages menu",
      "info": "Add primary pages, such as Collections and About Coco Rosette."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Customer care menu",
      "default": "footer",
      "info": "Add support pages, such as Contact, Size guide, Care guide, and FAQ."
    },
    {
      "type": "link_list",
      "id": "privacy_menu",
      "label": "Privacy choices menu",
      "info": "Select the menu chosen for Shopify's Data sharing opt-out page to render its link with the legal policies."
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        { "type": "text", "id": "label", "label": "Accessible label" },
        { "type": "url", "id": "url", "label": "Destination" }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
