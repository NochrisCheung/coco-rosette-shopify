{% liquid
  assign featured_collection = section.settings.collection
  assign featured_collection_url = featured_collection.url
  assign featured_collection_title = featured_collection.title
  assign has_products = false
  if featured_collection != blank and featured_collection.products_count > 0
    assign has_products = true
  endif
  if featured_collection.handle == 'the-collection'
    assign featured_collection_url = routes.all_products_collection_url
    assign featured_collection_title = 'collections.title' | t
  endif
%}

{% if has_products or request.design_mode %}
  <section class="coco-featured-collection" aria-labelledby="CocoCollectionTitle-{{ section.id }}">
    <div class="coco-featured-collection__heading">
      {% if section.settings.eyebrow != blank %}<p class="coco-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="CocoCollectionTitle-{{ section.id }}" class="coco-display">
        <span class="coco-featured-collection__heading-roman">{{ section.settings.heading_before | escape }}</span>
        <em class="coco-featured-collection__heading-script">{{ section.settings.heading_emphasis | escape }}</em>
      </h2>
      <span class="coco-divider" aria-hidden="true"></span>
    </div>

    {% if has_products %}
      <div class="coco-featured-collection__grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
      {% if section.settings.show_collection_link %}
        <p class="coco-featured-collection__cta">
          <a class="coco-button--secondary" href="{{ featured_collection_url }}">{{ 'collections.view_all' | t: title: featured_collection_title | escape }}</a>
        </p>
      {% endif %}
    {% else %}
      <div class="coco-empty-state">
        <div><p>{{ 'collections.editor_empty' | t }}</p></div>
      </div>
    {% endif %}
  </section>
{% endif %}

{% stylesheet %}
  .coco-featured-collection { padding: var(--cr-section-space) var(--cr-gutter); }
  .coco-featured-collection__heading { max-width: 47.5rem; margin: 0 auto 4rem; text-align: center; }
  .coco-featured-collection__heading .coco-eyebrow { margin-bottom: 1rem; }
  .coco-featured-collection__heading .coco-display { font-family: var(--cr-hero-roman); font-weight: 400; line-height: 1; }
  .coco-featured-collection__heading-roman { display: inline-block; font-size: 0.9em; letter-spacing: -0.03em; }
  .coco-featured-collection__heading .coco-featured-collection__heading-script { display: inline-block; margin-left: 0.05em; font-family: var(--cr-hero-script); font-size: 1.1em; font-style: normal; font-weight: 400; font-feature-settings: 'calt' 1, 'liga' 1, 'swsh' 1; font-variant-ligatures: common-ligatures contextual; letter-spacing: -0.03em; line-height: 0.8; }
  .coco-featured-collection__heading .coco-divider { margin-inline: auto; }
  .coco-featured-collection__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.25rem; width: min(100%, var(--cr-content-max)); margin-inline: auto; }
  .coco-featured-collection__cta { margin-top: 3rem; text-align: center; }
  @media (max-width: 900px) { .coco-featured-collection__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1.25rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Coco Rosette collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Featured collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_collection_link", "label": "Show collection link", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading_before", "label": "Heading before emphasis", "default": "Dressed for the" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading emphasis", "default": "Occasion" }
  ],
  "presets": [{ "name": "Coco Rosette collection" }]
}
{% endschema %}
