<section id="story" class="coco-story" aria-labelledby="coco-story-title">
  <img src="{{ 'coco-rosette-story-vine.png' | asset_url }}" width="256" height="768" alt="" class="coco-story__vine" aria-hidden="true" loading="lazy">
  <h2 id="coco-story-title" class="coco-story__title">{{ 'brand.story_heading' | t }}</h2>
  <blockquote>{{ section.settings.quote | escape }}</blockquote>
  <p>{{ section.settings.signature | escape }}</p>
</section>

{% stylesheet %}
  .coco-story { position: relative; overflow: clip; padding: 88px 32px 112px; text-align: center; }
  .coco-story__title { height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0 0 0 0); white-space: nowrap; }
  .coco-story__vine { position: absolute; top: 50%; left: max(2rem, calc(50% - 33rem)); display: block; width: clamp(3.25rem, 5vw, 4.5rem); height: auto; pointer-events: none; transform: translateY(-50%); }
  .coco-story blockquote { font-family: var(--cr-script); font-size: clamp(30px, 3.3vw, 44px); font-style: italic; font-weight: 500; line-height: 1.38; margin: 0 auto; max-width: 850px; }
  .coco-story p { color: var(--cr-gray); font-family: var(--cr-sans); font-size: 11px; font-weight: 300; letter-spacing: .32em; margin-top: 30px; text-transform: uppercase; }
  @media (max-width: 1100px) { .coco-story__vine { display: none; } }
  @media (max-width: 700px) { .coco-story { padding: 64px 32px 80px; } .coco-story p { font-size: 10px; line-height: 1.8; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Coco Rosette story",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Made for the moments when happiness, warmth and quiet joy are shared with the dogs you love." },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Coco Rosette · London" }
  ],
  "presets": [{ "name": "Coco Rosette story" }]
}
{% endschema %}
