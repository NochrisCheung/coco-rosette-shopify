{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign selected_media_id = blank
  assign uses_variant_map = false
  assign has_custom_size_option = false
  assign current_variant_uses_custom_size = false
  assign size_guide_page = pages['size-guide']
  assign product_form_errors_id = 'ProductFormErrors-' | append: section.id

  if current_variant != blank and current_variant.featured_media != blank
    assign selected_media_id = current_variant.featured_media.id
  elsif product.media.first != blank
    assign selected_media_id = product.media.first.id
  endif

  if product.variants_count <= 250
    assign uses_variant_map = true
  endif

  for option in product.options_with_values
    if option.name == 'Size'
      for option_value in option.values
        if option_value.name == 'Custom size'
          assign has_custom_size_option = true
          if option_value.selected
            assign current_variant_uses_custom_size = true
          endif
          break
        endif
      endfor
    endif
  endfor
%}

<coco-product class="coco-product" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-option-refresh-error="{{ 'products.options_refresh_error' | t | escape }}"{% unless uses_variant_map %} data-uses-server-option-refresh="true"{% endunless %}>
  <div class="coco-product__media-column">
    {% if product.media.size > 0 %}
      <div class="coco-product__media-stage">
        {% for media in product.media %}
          {% assign media_alt = media.alt | default: product.title %}
          <div class="coco-product__media" data-product-media-id="{{ media.id }}"{% unless media.id == selected_media_id %} hidden{% endunless %}>
            {% case media.media_type %}
              {% when 'image' %}
                {% if media.id == selected_media_id %}
                  {% render 'responsive-image',
                    image: media.preview_image,
                    alt: media_alt,
                    class: 'coco-product__image',
                    width: 1800,
                    widths: '480, 720, 960, 1200, 1600, 1800',
                    sizes: '(min-width: 900px) 52vw, 100vw',
                    loading: 'eager',
                    fetchpriority: 'high'
                  %}
                {% else %}
                  {% render 'responsive-image',
                    image: media.preview_image,
                    alt: media_alt,
                    class: 'coco-product__image',
                    width: 1800,
                    widths: '480, 720, 960, 1200, 1600, 1800',
                    sizes: '(min-width: 900px) 52vw, 100vw',
                    loading: 'lazy'
                  %}
                {% endif %}
              {% else %}
                {{ media | media_tag: image_size: '1200x' }}
            {% endcase %}
          </div>
        {% endfor %}
      </div>

      {% if product.media.size > 1 %}
        <ul class="coco-product__media-thumbnails" role="list">
          {% for media in product.media %}
            <li>
              <button
                class="coco-product__media-thumbnail{% if media.id == selected_media_id %} is-active{% endif %}"
                type="button"
                aria-label="{{ 'products.view_media' | t: position: forloop.index }}"
                aria-pressed="{% if media.id == selected_media_id %}true{% else %}false{% endif %}"
                data-product-media-button="{{ media.id }}"
              >
                {% if media.preview_image != blank %}
                  {% render 'responsive-image',
                    image: media.preview_image,
                    alt: '',
                    class: 'coco-product__thumbnail-image',
                    width: 160,
                    widths: '80, 120, 160',
                    sizes: '72px',
                    loading: 'lazy'
                  %}
                {% else %}
                  <span>{{ forloop.index }}</span>
                {% endif %}
              </button>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% else %}
      <div class="coco-product__media-empty" aria-hidden="true"></div>
    {% endif %}
  </div>

  <div class="coco-product__information">
    <div class="coco-product__identity">
      {% if product.type != blank %}<p class="coco-eyebrow">{{ product.type | escape }}</p>{% endif %}
      <h1 class="coco-display">{{ product.title | escape }}</h1>
      <div class="coco-product__price" aria-live="polite" data-product-price>
        {% render 'price', product: product, variant: current_variant %}
      </div>
      <span class="coco-product__garden-rule" aria-hidden="true"></span>
    </div>

    {% form 'product', product, id: product_form_id, class: 'coco-product__form', data-product-form: 'true' %}
      {% render 'form-errors', form: form, id: product_form_errors_id %}
      <p class="coco-form-errors" role="alert" hidden data-product-form-error></p>
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-variant-id>

      {% unless product.has_only_default_variant %}
        <div class="coco-product__options">
          {% for option in product.options_with_values %}
            {% if option.name == 'Colour' %}
              {% render 'product-option', product_form_id: product_form_id, option: option, size_guide_page: size_guide_page %}
            {% endif %}
          {% endfor %}
          {% for option in product.options_with_values %}
            {% unless option.name == 'Colour' or option.name == 'Size' %}
              {% render 'product-option', product_form_id: product_form_id, option: option, size_guide_page: size_guide_page %}
            {% endunless %}
          {% endfor %}
          {% for option in product.options_with_values %}
            {% if option.name == 'Size' %}
              {% render 'product-option', product_form_id: product_form_id, option: option, size_guide_page: size_guide_page %}
            {% endif %}
          {% endfor %}
        </div>
      {% endunless %}

      {% if has_custom_size_option %}
        <fieldset class="coco-product__custom-size" data-custom-size-measurements{% unless current_variant_uses_custom_size %} hidden aria-hidden="true"{% endunless %}>
          <legend class="coco-ui-label">{{ 'products.custom_size.measurements' | t }}</legend>
          <p id="CustomSizeHelp-{{ section.id }}" class="coco-product__custom-size-copy">{{ 'products.custom_size.description' | t }}</p>
          <div class="coco-product__custom-size-fields">
            <p>
              <label for="CustomSizeChest-{{ section.id }}">{{ 'products.custom_size.chest' | t }}</label>
              <input id="CustomSizeChest-{{ section.id }}" class="coco-field" type="number" name="properties[Chest (cm)]" min="0.1" step="0.1" inputmode="decimal" aria-describedby="CustomSizeHelp-{{ section.id }}" data-custom-size-input{% if current_variant_uses_custom_size %} required{% else %} disabled{% endif %}>
            </p>
            <p>
              <label for="CustomSizeLength-{{ section.id }}">{{ 'products.custom_size.body_length' | t }}</label>
              <input id="CustomSizeLength-{{ section.id }}" class="coco-field" type="number" name="properties[Body length (cm)]" min="0.1" step="0.1" inputmode="decimal" aria-describedby="CustomSizeHelp-{{ section.id }}" data-custom-size-input{% if current_variant_uses_custom_size %} required{% else %} disabled{% endif %}>
            </p>
            <p>
              <label for="CustomSizeNeck-{{ section.id }}">{{ 'products.custom_size.neck_circumference' | t }}</label>
              <input id="CustomSizeNeck-{{ section.id }}" class="coco-field" type="number" name="properties[Neck circumference (cm)]" min="0.1" step="0.1" inputmode="decimal" aria-describedby="CustomSizeHelp-{{ section.id }}" data-custom-size-input{% if current_variant_uses_custom_size %} required{% else %} disabled{% endif %}>
            </p>
          </div>
        </fieldset>
        {% unless current_variant_uses_custom_size %}
          <noscript>
            <style>[data-custom-size-option], [data-custom-size-option-label] { display: none !important; }</style>
            <p class="coco-product__custom-size-noscript">{{ 'products.custom_size.javascript_required' | t }}</p>
          </noscript>
        {% endunless %}
      {% endif %}

      <p class="coco-product__delivery-promise">{{ 'products.delivery_promise' | t }}</p>

      <div class="coco-product__purchase-row">
        <label class="coco-visually-hidden" for="ProductQuantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
        <div class="coco-quantity-input">
          <button type="button" data-product-quantity-button="decrease" aria-label="{{ 'products.decrease_quantity' | t }}">{% render 'icon', name: 'minus', class: 'coco-icon' %}</button>
          <input id="ProductQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-product-quantity>
          <button type="button" data-product-quantity-button="increase" aria-label="{{ 'products.increase_quantity' | t }}">{% render 'icon', name: 'plus', class: 'coco-icon' %}</button>
        </div>
        <button
          class="coco-button coco-product__add-button"
          type="submit"
          data-product-add-button
          data-add-label="{{ 'products.add_to_bag' | t }}"
          data-sold-out-label="{{ 'products.sold_out' | t }}"
          data-unavailable-label="{{ 'products.unavailable' | t }}"
          {% if current_variant == blank or current_variant.available == false %}disabled{% endif %}
        >
          {% if current_variant == blank %}
            {{ 'products.unavailable' | t }}
          {% elsif current_variant.available %}
            {{ 'products.add_to_bag' | t }}
          {% else %}
            {{ 'products.sold_out' | t }}
          {% endif %}
        </button>
      </div>
      <p class="coco-product__availability" role="status" data-product-availability>
        {% if current_variant == blank %}
          {{ 'products.unavailable' | t }}
        {% elsif current_variant.available == false %}
          {{ 'products.sold_out' | t }}
        {% endif %}
      </p>
    {% endform %}

    {% if product.description != blank %}
      <div class="coco-product__description rte" data-product-description>{{ product.description }}</div>
    {% endif %}
  </div>

  {% if uses_variant_map %}
    <script type="application/json" data-product-variants>
      [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | money | json }},
            "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "featuredMediaId": {% if variant.featured_media != blank %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  {% endif %}
</coco-product>

{% stylesheet %}
  .coco-product { --coco-product-section-gap: 1.5rem; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.88fr); gap: clamp(3rem, 8vw, 8rem); width: min(100% - (var(--cr-gutter) * 2), var(--cr-content-max)); margin: 0 auto; padding-block: var(--cr-section-space); }
  .coco-product__media-column { --coco-thumbnail-width: 4rem; --coco-thumbnail-gap: 1rem; container-type: inline-size; display: grid; grid-template-columns: var(--coco-thumbnail-width) minmax(0, 1fr); align-items: start; gap: var(--coco-thumbnail-gap); }
  .coco-product__media-stage { grid-column: 2; grid-row: 1; overflow: hidden; background: var(--cr-white); }
  .coco-product__media { width: 100%; }
  .coco-product__media > img, .coco-product__media > video, .coco-product__media > model-viewer, .coco-product__media > iframe { width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
  .coco-product__media-empty { min-height: 34rem; border: 1px solid var(--cr-divider); background: linear-gradient(180deg, var(--cr-placeholder-wash), transparent); }
  .coco-product__media-thumbnails { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; gap: 0.625rem; block-size: calc(150cqw - 7.5rem); margin: 0; padding: 0; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; list-style: none; }
  .coco-product__media-thumbnails > li { flex: 0 0 auto; }
  .coco-product__media-thumbnail { display: block; width: var(--coco-thumbnail-width); height: 5.25rem; overflow: hidden; border: 1px solid transparent; padding: 0; background: var(--cr-white); }
  .coco-product__media-thumbnail.is-active { border-color: var(--cr-rose); }
  .coco-product__thumbnail-image { width: 100%; height: 100%; object-fit: cover; }
  .coco-product__information { align-self: start; max-width: 28rem; padding-top: clamp(0.5rem, 2vw, 1.75rem); }
  .coco-product__identity { padding-bottom: 1.5rem; border-bottom: 1px solid var(--cr-divider); }
  .coco-product__identity > .coco-eyebrow { margin-bottom: 0.625rem; font-size: 0.625rem; }
  .coco-product__identity > .coco-display { font-size: clamp(1.125rem, 1.35vw, 1.25rem); line-height: 1.3; }
  .coco-product__price { margin-top: 0.375rem; }
  .coco-product__price .coco-price { font-size: 0.875rem; }
  .coco-product__garden-rule { display: block; width: 4.5rem; height: 1px; margin-top: 1.25rem; background: var(--cr-rose); }
  .coco-product__description { margin-top: 2rem; font-size: 0.875rem; line-height: 1.6; }
  .coco-product__description:not(.coco-product__description--disclosures) > * + * { margin-top: 0.875rem; }
  .coco-product__description--disclosures { border-bottom: 1px solid var(--cr-divider); }
  .coco-product__description--disclosures > :first-child:not(.coco-product__description-disclosure) { margin-bottom: var(--coco-product-section-gap); }
  .coco-product__description h2 { font-size: 1rem; line-height: 1.3; }
  .coco-product__description h3 { font-size: 0.9375rem; line-height: 1.35; }
  .coco-product__description-disclosure { margin: 0; border-top: 1px solid var(--cr-divider); }
  .coco-product__description-disclosure > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.25rem; cursor: pointer; font-family: var(--cr-serif); font-size: 1rem; line-height: 1.3; list-style: none; }
  .coco-product__description-disclosure > summary::-webkit-details-marker { display: none; }
  .coco-product__description-disclosure > summary::after { content: '+'; flex: 0 0 auto; color: var(--cr-gray); font-family: var(--cr-sans); font-size: 1.125rem; font-weight: 300; }
  .coco-product__description-disclosure[open] > summary::after { content: '−'; }
  .coco-product__description-disclosure > :not(summary) { margin: 0; padding-bottom: 1rem; }
  .coco-product__description-disclosure > :not(summary) + :not(summary) { margin-top: 0.75rem; }
  .coco-product__form { margin-top: var(--coco-product-section-gap); }
  .coco-product__options { display: grid; gap: 1.375rem; }
  .coco-product__option { margin: 0; border: 0; padding: 0; }
  .coco-product__option-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .coco-product__option-heading .coco-ui-label, .coco-product__custom-size .coco-ui-label { font-size: 0.625rem; }
  .coco-product__size-guide-link { display: inline-flex; align-items: baseline; min-height: 1.5rem; border-bottom: 1px solid var(--cr-rose); padding: 0 0 0.175rem; color: var(--cr-ink); font-size: 0.625rem; font-weight: 400; letter-spacing: 0.16em; line-height: 1; text-decoration: none; text-transform: uppercase; transition: border-color 160ms ease, color 160ms ease; }
  .coco-product__size-guide-link::after { content: '→'; margin-left: 0.25rem; font-size: 0.625rem; letter-spacing: 0; line-height: 1; transition: transform 160ms ease; }
  .coco-product__size-guide-link:hover { border-color: var(--cr-ink); color: var(--cr-rose); }
  .coco-product__size-guide-link:hover::after { transform: translateX(0.1rem); }
  .coco-product__size-guide-link:focus-visible { outline: none; box-shadow: 0 2px 0 var(--cr-ink), var(--cr-focus); }
  .coco-product__option-values { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.625rem; }
  .coco-product__option-input { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); }
  .coco-product__option-label { display: inline-flex; align-items: center; min-height: 2.5rem; border: 1px solid var(--cr-divider); padding: 0.5rem 0.875rem; cursor: pointer; font-size: 0.75rem; }
  .coco-product__option-label--colour { gap: 0.5rem; }
  .coco-product__option-swatch { width: 0.75rem; height: 0.75rem; flex: 0 0 0.75rem; border: 1px solid rgba(29, 21, 21, 0.22); border-radius: 50%; background-color: var(--coco-product-option-swatch-colour, var(--cr-placeholder-wash)); background-image: var(--coco-product-option-swatch-image, none); background-position: center; background-size: cover; }
  .coco-product__option-input:checked + .coco-product__option-label { border-color: var(--cr-ink); background: var(--cr-ink); color: var(--cr-white); }
  .coco-product__option-input:checked + .coco-product__option-label--colour .coco-product__option-swatch { border-color: rgba(251, 251, 250, 0.72); }
  .coco-product__option-input:focus-visible + .coco-product__option-label { box-shadow: var(--cr-focus); }
  .coco-product__option-input:disabled + .coco-product__option-label { cursor: not-allowed; opacity: 0.4; text-decoration: line-through; }
  .coco-product__custom-size { margin: 1.25rem 0 0; border: 1px solid var(--cr-divider); padding: 1rem; }
  .coco-product__custom-size[hidden] { display: none; }
  .coco-product__custom-size-copy { margin-top: 0.5rem; color: var(--cr-gray); font-size: 0.75rem; }
  .coco-product__custom-size-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; margin-top: 0.875rem; }
  .coco-product__custom-size-fields p { margin: 0; }
  .coco-product__custom-size-fields label { display: block; margin-bottom: 0.4rem; font-size: 0.75rem; }
  .coco-product__custom-size-fields .coco-field { min-width: 0; }
  .coco-product__custom-size-noscript { margin-top: 1rem; color: var(--cr-rose); font-size: 0.75rem; }
  .coco-product__delivery-promise { margin-top: 1.5rem; border-inline-start: 1px solid var(--cr-divider); padding-inline-start: 0.75rem; color: var(--cr-gray); font-size: 0.75rem; }
  .coco-product__purchase-row { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .coco-product__add-button { flex: 1; }
  .coco-product__add-button:disabled { background: var(--cr-gray); }
  .coco-product__availability { min-height: 1.55em; margin-top: 0.625rem; color: var(--cr-rose); font-size: 0.75rem; }
  @media (max-width: 850px) { .coco-product { grid-template-columns: 1fr; max-width: 42rem; } .coco-product__media-column { display: block; } .coco-product__media-stage { display: block; } .coco-product__media-thumbnails { display: flex; flex-direction: row; block-size: auto; gap: 0.75rem; margin: 1rem 0 0; overflow-x: auto; overflow-y: hidden; } .coco-product__media-thumbnail { width: 4.5rem; height: 5.75rem; } .coco-product__media-empty { min-height: 28rem; } .coco-product__information { max-width: none; padding-top: 0; } .coco-product__custom-size-fields { grid-template-columns: 1fr; } }
  @media (max-width: 450px) { .coco-product__purchase-row { align-items: stretch; flex-direction: column; } .coco-product__purchase-row .coco-quantity-input { width: fit-content; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
