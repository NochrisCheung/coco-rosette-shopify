{% liquid
  assign password_form_errors_id = 'PasswordFormErrors-' | append: section.id
%}

<section class="coco-password coco-content">
  <a class="coco-password__logo" href="{{ routes.root_url }}" aria-label="{{ 'accessibility.home' | t: shop_name: shop.name | escape }}">
    {% render 'logo', width: 300 %}
  </a>
  <p class="coco-eyebrow">{{ 'password.eyebrow' | t }}</p>
  <h1 class="coco-display">{{ 'password.title' | t }}</h1>
  {% if shop.password_message != blank %}<p class="coco-password__message">{{ shop.password_message | escape }}</p>{% endif %}

  {% form 'storefront_password', class: 'coco-password__form' %}
    {% render 'form-errors', form: form, id: password_form_errors_id %}
    <label class="coco-visually-hidden" for="PasswordInput-{{ section.id }}">{{ 'password.password' | t }}</label>
    <input id="PasswordInput-{{ section.id }}" class="coco-field" type="password" name="password" placeholder="{{ 'password.password' | t }}" autocomplete="current-password" required>
    <button class="coco-button" type="submit">{{ 'password.enter' | t }}</button>
  {% endform %}
</section>

{% stylesheet %}
  .coco-password { display: grid; min-height: 100vh; place-content: center; max-width: 34rem; padding-block: 3rem; text-align: center; }
  .coco-password__logo { width: min(100%, 18.75rem); margin: 0 auto 4rem; }
  .coco-password .coco-eyebrow { margin-bottom: 0.75rem; }
  .coco-password__message { margin: 1.25rem auto 2rem; color: var(--cr-gray); }
  .coco-password__form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.75rem; }
  .coco-password__form .coco-form-errors { grid-column: 1 / -1; text-align: left; }
  @media (max-width: 500px) { .coco-password__form { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
