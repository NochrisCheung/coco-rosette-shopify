<section class="coco-recovery coco-content">
  <p class="coco-eyebrow">{{ '404.title' | t }}</p>
  <h1 class="coco-display">{{ '404.not_found' | t }}</h1>
  <p class="coco-recovery__copy">{{ '404.copy' | t }}</p>
  <a class="coco-button coco-recovery__shopping-link" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
</section>

{% stylesheet %}
  .coco-recovery { display: grid; min-height: 50vh; place-content: center; max-width: 42rem; padding-block: var(--cr-section-space); text-align: center; }
  .coco-recovery .coco-eyebrow { margin-bottom: 0.75rem; }
  .coco-recovery__copy { margin: 1.25rem auto 2rem; color: var(--cr-gray); }
  .coco-recovery__shopping-link { margin-top: 1.25rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Not found",
  "settings": []
}
{% endschema %}
